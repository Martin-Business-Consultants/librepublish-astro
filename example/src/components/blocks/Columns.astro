---
// The columns block holds blocks of its own: another <Blocks>, with the same map.
import Blocks from "@librepublish/astro/components/Blocks.astro";
import type { BlockProps } from "librepublish:types";
import { components } from "./index";

type Props = BlockProps<"columns">;
const { column_count, items, assets } = Astro.props;
---
<section data-block="columns" style={`display:grid;grid-template-columns:repeat(${column_count},1fr)`}>
  <Blocks blocks={items} components={components} assets={assets} />
</section>
