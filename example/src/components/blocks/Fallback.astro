---
// The block types the example doesn't design: its type and data, plainly.
import type { Block } from "librepublish:types";

interface Props { block: Block }
const { block } = Astro.props;
---
<section data-block={block.type}>
  <h2>{block.type}</h2>
  <pre>{JSON.stringify(block.data, null, 2)}</pre>
  {block.resolved && <pre data-resolved>{JSON.stringify(block.resolved, null, 2)}</pre>}
</section>
