---
// The hero block: its data arrives typed from the CMS's schema.
import Image from "@librepublish/astro/components/Image.astro";
import { linkHref } from "@librepublish/astro/client";
import type { BlockProps } from "librepublish:types";

type Props = BlockProps<"hero">;
const { heading, subheading, image_id, ctas, assets } = Astro.props;
---
<section data-block="hero">
  <h2>{heading}</h2>
  {subheading && <p>{subheading}</p>}
  <Image asset={image_id ? assets[image_id] : null} sizes="100vw" />
  {(ctas ?? []).map((cta) => <a href={linkHref(cta.url)} data-style={cta.style}>{cta.label}</a>)}
</section>
