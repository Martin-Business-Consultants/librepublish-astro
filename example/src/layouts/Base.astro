---
import { getEntry } from "astro:content";
import Seo from "@librepublish/astro/components/Seo.astro";
import BrandStyles from "@librepublish/astro/components/BrandStyles.astro";
import { runtimeClient } from "@librepublish/astro/runtime/env";
import { linkHref } from "@librepublish/astro/client";
import { assetsById } from "../lib/assets";

interface Props {
  record?: { title: string; locale: string; seo: Record<string, unknown>; translations: { locale: string; path: string }[] };
  title?: string;
}

const { record, title } = Astro.props;
const assets = await assetsById();
const nav = (await getEntry("globals", "nav"))?.data;
const items = nav?.slug === "nav" ? nav.data.items ?? [] : [];
// Settings › Brand: colors, font, corners and shadow as --brand-* properties.
const site = (await runtimeClient().site()).data;
---
<!doctype html>
<html lang={record?.locale ?? "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {record ? <Seo record={record} assets={assets} /> : <title>{title}</title>}
    {site.branding.favicon && <link rel="icon" href={site.branding.favicon.url} />}
    <BrandStyles site={site} />
    <style is:global>
      body { font-family: var(--brand-font, system-ui, sans-serif); }
      a { color: var(--brand-primary, inherit); }
    </style>
  </head>
  <body>
    <nav>{site.branding.logo && <img src={site.branding.logo.url} alt={site.branding.logo.alt || site.name} height="32" />}{items.map((item) => <a href={linkHref(item.link)}>{item.label}</a>)}</nav>
    <main><slot /></main>
  </body>
</html>
