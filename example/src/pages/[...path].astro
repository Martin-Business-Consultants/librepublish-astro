---
import { getCollection } from "astro:content";
import Blocks from "@librepublish/astro/components/Blocks.astro";
import Image from "@librepublish/astro/components/Image.astro";
import { routeParam } from "@librepublish/astro/client";
import Base from "../layouts/Base.astro";
import { components } from "../components/blocks";
import { assetsById } from "../lib/assets";

export async function getStaticPaths() {
  // Served where the CMS says each page lives: "/" for the home page, "/fr/…"
  // for French; routeParam handles an absolute SEO canonical too.
  return (await getCollection("pages")).map(({ data: page }) => ({
    params: { path: routeParam(page, { site: import.meta.env.SITE }) },
    props: { page },
  }));
}

const { page } = Astro.props;
const assets = await assetsById();
---
<Base record={page}>
  <h1>{page.title}</h1>
  {/* A page with fields of its own has them typed by its path. */}
  {page.path === "about" && "tagline" in page.frontmatter && <p class="tagline">{page.frontmatter.tagline}</p>}
  {/* The page's sharing image, as an example of <Image>. */}
  <Image asset={page.seo.og_image_id ? assets[page.seo.og_image_id] : null} sizes="(min-width: 60rem) 60rem, 100vw" />
  <Blocks blocks={page.blocks} components={components} assets={assets} />
</Base>
