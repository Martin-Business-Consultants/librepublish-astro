---
// The CMS's "contact" form, drawn on each request from its live definition
// and posting straight to the CMS. <Form> renders on demand only.
import Form from "@librepublish/astro/components/Form.astro";
import Base from "../layouts/Base.astro";

export const prerender = false;
---
<Base title="Contact">
  <h1>Contact</h1>
  <Form slug="contact" />
</Base>
