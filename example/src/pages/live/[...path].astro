---
// On demand only (SSR=1): the page as the CMS has it now, through a live
// collection, checked against the CMS's schema as it is. A build without
// SSR=1 leaves this route out (astro.config.mjs).
import { getLiveEntry } from "astro:content";
import Blocks from "@librepublish/astro/components/Blocks.astro";
import { cacheHint } from "@librepublish/astro/live";
import Base from "../../layouts/Base.astro";
import { components } from "../../components/blocks";

export function getStaticPaths() { return []; }

const { entry, error, cacheHint: hint } = await getLiveEntry("livePages", (Astro.params as { path?: string }).path || "home");
// An empty 404 renders the site's 404 page.
if (error?.name === "LiveEntryNotFoundError" || (!error && !entry)) return new Response(null, { status: 404 });
if (error || !entry) throw error;
const page = entry.data;
// Cache-Tag: page:<path>, so publishing this page purges it.
cacheHint(Astro, hint);
---
<Base record={page}>
  <h1>{page.title}</h1>
  <Blocks blocks={page.blocks} components={components} />
</Base>
