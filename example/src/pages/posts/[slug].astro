---
import { getCollection } from "astro:content";
import Blocks from "@librepublish/astro/components/Blocks.astro";
import Image from "@librepublish/astro/components/Image.astro";
import RichText from "@librepublish/astro/components/RichText.astro";
import Base from "../../layouts/Base.astro";
import { components } from "../../components/blocks";
import { assetsById } from "../../lib/assets";

export async function getStaticPaths() {
  return (await getCollection("posts")).map((post) => ({ params: { slug: post.id }, props: { post: post.data } }));
}
const { post } = Astro.props;
const assets = await assetsById();
---
<Base record={post}>
  <h1>{post.title}</h1>
  <p>{post.frontmatter.summary}</p>
  <Image asset={post.frontmatter.cover ? assets[post.frontmatter.cover] : null} sizes="100vw" />
  {/* body_markdown is the CMS's rich text (Markdown), drawn as HTML. */}
  {post.body_markdown && <article><RichText value={post.body_markdown} /></article>}
  <Blocks blocks={post.blocks} components={components} assets={assets} />
</Base>
