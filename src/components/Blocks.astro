---
/**
 * A page's (or entry's) blocks, each rendered by the component for its type:
 *
 *   ---
 *   import type { BlockComponents } from "librepublish:types";
 *   const components = { hero: Hero, text: Text, … } satisfies BlockComponents;
 *   ---
 *   <Blocks blocks={page.blocks} components={components} assets={assets} />
 *
 * `components` is typed from the CMS's schema: every block type the CMS has
 * needs a component, and one the CMS doesn't have is an error (astro check).
 * Each component gets the block's data as props, plus `block` (type, id and
 * data), `resolved` (what the CMS filled in: a collection_list's entries,
 * contact_info's contact details) and `assets` (by id) for its images. A
 * field of type `blocks` holds blocks of the same shape: render them with
 * another <Blocks>.
 *
 * A block whose type has no component stops the build (and `astro dev`): it
 * is never skipped quietly. On a page rendered on demand it's left out and
 * logged as an error, rather than failing the request.
 */
import type { Assets, Block, BlockComponents } from "librepublish:types";

interface Props {
  blocks: Block[] | null | undefined;
  components: BlockComponents;
  assets?: Assets;
}

const { blocks, components, assets = {} } = Astro.props;
const list = (Array.isArray(blocks) ? blocks : []) as Block[];
const table = components as Record<string, any>;
const missing = [...new Set(list.filter((block) => !table[block.type]).map((block) => block.type))];
if (missing.length) {
  const message = `[librepublish] <Blocks> has no component for block type${missing.length > 1 ? "s" : ""} ${missing.map((type) => `"${type}"`).join(", ")} (on ${Astro.url.pathname}). Add ${missing.length > 1 ? "them" : "it"} to the components map: every block type the CMS has needs one.`;
  if (Astro.isPrerendered || import.meta.env.DEV) throw new Error(message);
  console.error(message);
}
---
{list.map((block) => {
  const Component = table[block.type];
  return Component ? <Component {...(block.data ?? {})} block={block} resolved={block.resolved} assets={assets} /> : null;
})}
