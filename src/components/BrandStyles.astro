---
/**
 * The site's visual identity (the CMS's Settings › Brand) as CSS custom
 * properties on :root, for the site's own CSS to read: --brand-primary,
 * --brand-on-primary, --brand-secondary, --brand-font, --brand-radius and
 * --brand-shadow (brandingCss). Put it in the <head>:
 *
 *   ---
 *   const site = (await cms.site()).data;
 *   ---
 *   <BrandStyles site={site} loadFont />
 *   <style>body { font-family: var(--brand-font, system-ui); }</style>
 *
 * Every value is checked again here (hex colors, the CMS's fonts, corners
 * and shadows) and rebuilt, so nothing from the API reaches the CSS as it
 * came. Nothing is drawn when nothing is set. With `loadFont`, the font's
 * Google Fonts stylesheet is linked too.
 */
import type { CmsBranding, CmsSite } from "@librepublish/astro/client";
import { brandingCss, brandingFontHref } from "@librepublish/astro/branding";

interface Props {
  /** GET /api/v1/site's data (or anything with its `branding`). */
  site?: Pick<CmsSite, "branding"> | null;
  /** The branding itself, instead of `site`. */
  branding?: CmsBranding | null;
  /** Link the font's stylesheet from Google Fonts. Default false: the site loads its fonts itself. */
  loadFont?: boolean;
  /** The rule's selector. Default ":root". */
  selector?: string;
}

const { site, branding, loadFont = false, selector } = Astro.props;
const source = site ?? branding;
const css = brandingCss(source, { selector });
const fontHref = loadFont ? brandingFontHref(source) : null;
---
{fontHref && (
  <>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontHref} />
  </>
)}
{css && <style is:inline set:html={css} />}
