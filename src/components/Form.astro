---
/**
 * A form built in the CMS (the Forms plugin), drawn on each request from its
 * live definition — so what the visitor sees is what the CMS has now:
 *
 *   ---
 *   import Form from "@librepublish/astro/components/Form.astro";
 *   export const prerender = false;
 *   ---
 *   <Form slug="contact" />
 *
 * It renders on demand only: on a prerendered page it stops the build, since
 * a form baked into HTML goes stale the moment someone edits it in the CMS.
 * (The site needs an adapter for pages rendered on demand.)
 *
 * Every field type the CMS's builder has, with its width, rows, limits,
 * choices, default and help; a honeypot (_hp) and the time the page loaded
 * (_ts), always; the CMS's captcha and its script, when the form has one.
 * The browser posts straight to the CMS. With JavaScript, the fields are
 * checked first by the rules the definition declares (one validator for
 * every form, @librepublish/astro/forms/rules), the post goes in place, and
 * the CMS's answer lands beside each field. Without, the browser posts it and
 * the CMS sends the visitor back with ?form=<slug>&form_status=sent|error, or
 * to the form's thank-you page.
 *
 * Unstyled beyond layout: classes are cms-form__*, and the form's
 * data-state is idle, sending, sent or failed.
 */
import { clientRules, formDefinition, type FormField } from "@librepublish/astro/forms";

interface Props {
  slug: string;
  class?: string;
}

const { slug, class: className } = Astro.props;
if (Astro.isPrerendered) {
  throw new Error(
    `<Form slug="${slug}"> is on a prerendered page (${Astro.url.pathname}). A form renders on demand from its live definition: ` +
    "add `export const prerender = false` to the page (and an adapter to astro.config).",
  );
}

// Read on every request: never cached by the site. (Don't cache the page at
// the edge either, or the form there goes stale.)
const form = await formDefinition(slug);

const id = `cms-form-${form.slug}`;
const fields = form.fields;
const multipart = fields.some((field) => field.type === "file");
const honeypot = form.spam.honeypot_field || "_hp";
const timestamp = form.spam.timestamp_field || "_ts";
const captcha = form.spam.captcha;
const returned = Astro.url.searchParams.get("form") === form.slug ? Astro.url.searchParams.get("form_status") : null;
const state = returned === "sent" ? "sent" : returned === "error" ? "failed" : "idle";
const rules = JSON.stringify(clientRules(form)).replace(/</g, "\\u003c");
// Where a post without JavaScript comes back to: this page, without a previous answer's status.
const back = new URL(Astro.url);
back.searchParams.delete("form");
back.searchParams.delete("form_status");

const fieldId = (field: FormField) => `${id}-${field.name}`;
const required = (field: FormField) => field.rules?.required ?? field.required ?? false;
const maxLength = (field: FormField) => field.rules?.max_length ?? (field.max_length || undefined);
const min = (field: FormField) => field.rules?.min ?? field.min;
const max = (field: FormField) => field.rules?.max ?? field.max;
const describedBy = (field: FormField) => [field.help ? `${fieldId(field)}-help` : null, `${fieldId(field)}-error`].filter(Boolean).join(" ");
const autocomplete: Record<string, string> = { email: "email", tel: "tel", url: "url" };
---
<form
  id={id}
  class:list={["cms-form", className]}
  action={form.action}
  method="post"
  enctype={multipart ? "multipart/form-data" : undefined}
  data-cms-form={form.slug}
  data-state={state}
>
  {!form.open ? (
    <p class="cms-form__closed">This form isn't taking submissions.</p>
  ) : (
    <Fragment>
      <div class="cms-form__fields">
        {fields.map((field) => {
          if (field.type === "heading") return <h3 class="cms-form__heading">{field.text || field.label}</h3>;
          if (field.type === "hidden") return <input type="hidden" name={field.name} value={field.default ?? ""} />;
          const fid = fieldId(field);
          const error = <p class="cms-form__error" id={`${fid}-error`} data-error-for={field.name} hidden></p>;
          const help = field.help && <p class="cms-form__help" id={`${fid}-help`}>{field.help}</p>;
          const mark = required(field) && <span class="cms-form__required" aria-hidden="true"> *</span>;
          return (
            <div class:list={["cms-form__field", `cms-form__field--${field.type}`, field.width === "half" ? "cms-form__field--half" : "cms-form__field--full"]} data-field={field.name}>
              {field.type === "checkbox" ? (
                <label for={fid} class="cms-form__check">
                  <input id={fid} type="checkbox" name={field.name} value="yes" required={required(field)} checked={field.default === "yes" || field.default === "true"} aria-describedby={describedBy(field)} />
                  {" "}{field.text || field.label}{mark}
                </label>
              ) : field.type === "radio" || field.type === "checkboxes" ? (
                <fieldset class="cms-form__choices" aria-describedby={describedBy(field)}>
                  <legend>{field.label}{mark}</legend>
                  {(field.options ?? []).map((option, index) => (
                    <label class="cms-form__check">
                      <input
                        type={field.type === "radio" ? "radio" : "checkbox"}
                        name={field.name}
                        value={option}
                        required={field.type === "radio" && required(field) && index === 0}
                        checked={field.default === option}
                      />
                      {" "}{option}
                    </label>
                  ))}
                </fieldset>
              ) : (
                <Fragment>
                  <label for={fid}>{field.label}{mark}</label>
                  {field.type === "textarea" ? (
                    <textarea id={fid} name={field.name} rows={field.rows || 5} required={required(field)} maxlength={maxLength(field)} placeholder={field.placeholder} aria-describedby={describedBy(field)}>{field.default ?? ""}</textarea>
                  ) : field.type === "select" ? (
                    <select id={fid} name={field.name} required={required(field)} aria-describedby={describedBy(field)}>
                      <option value="">{field.placeholder || "Choose…"}</option>
                      {(field.options ?? []).map((option) => <option value={option} selected={field.default === option}>{option}</option>)}
                    </select>
                  ) : field.type === "file" ? (
                    <input id={fid} type="file" name={field.name} required={required(field)} accept={field.rules?.accept?.join(",") ?? field.accept} aria-describedby={describedBy(field)} />
                  ) : (
                    <input
                      id={fid}
                      type={field.type}
                      name={field.name}
                      value={field.default}
                      required={required(field)}
                      placeholder={field.placeholder}
                      maxlength={field.type === "number" || field.type === "date" ? undefined : maxLength(field)}
                      min={field.type === "number" ? min(field) : undefined}
                      max={field.type === "number" ? max(field) : undefined}
                      step={field.type === "number" ? "any" : undefined}
                      pattern={field.type === "email" || field.type === "tel" || field.type === "url" ? field.rules?.pattern : undefined}
                      autocomplete={autocomplete[field.type]}
                      aria-describedby={describedBy(field)}
                    />
                  )}
                </Fragment>
              )}
              {help}
              {error}
            </div>
          );
        })}
      </div>

      <div class="cms-form__honeypot" aria-hidden="true">
        <label>Leave this empty <input type="text" name={honeypot} value="" tabindex="-1" autocomplete="off" /></label>
      </div>
      <input type="hidden" name={timestamp} value={String(Date.now())} data-cms-ts />
      <input type="hidden" name="_return" value={back.href} />

      {captcha && (
        <div class="cms-form__captcha">
          <div class={captcha.provider === "turnstile" ? "cf-turnstile" : "g-recaptcha"} data-sitekey={captcha.site_key}></div>
          <p class="cms-form__error" data-error-for="captcha" hidden></p>
        </div>
      )}

      <button type="submit" class="cms-form__submit">{form.submit_label || "Send"}</button>
    </Fragment>
  )}
  <p class="cms-form__status" role="status" aria-live="polite">
    {state === "sent" ? (form.success_message || "Thanks — we got it.") : state === "failed" ? "Something wasn't right: check the form and send it again." : ""}
  </p>
  <script type="application/json" data-cms-form-rules set:html={rules}></script>
</form>

{captcha && <script is:inline src={captcha.script} async defer></script>}

<style>
  :where(.cms-form__fields) { display: flex; flex-wrap: wrap; gap: 1rem; }
  :where(.cms-form__field, .cms-form__heading) { flex: 1 1 100%; min-width: 0; }
  :where(.cms-form__field--half) { flex: 1 1 calc(50% - 0.5rem); }
  :where(.cms-form__honeypot) { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
</style>

<script>
  import { postedFrom, sentence, validate, type FieldErrors, type RuledField } from "@librepublish/astro/forms/rules";

  interface Config { slug: string; success: string; redirect: string; fields: (RuledField & { label: string })[] }

  const MESSAGES: Record<number, string> = {
    410: "This form isn't taking submissions.",
    429: "Too many tries: please wait a few minutes.",
  };

  for (const form of document.querySelectorAll<HTMLFormElement>("form[data-cms-form]")) {
    const config = JSON.parse(form.querySelector("script[data-cms-form-rules]")?.textContent ?? "{}") as Config;
    const status = form.querySelector<HTMLElement>(".cms-form__status")!;
    const labels = new Map(config.fields.map((field) => [field.name, field.label]));
    const stamp = () => form.querySelectorAll<HTMLInputElement>("input[data-cms-ts]").forEach((input) => { input.value = String(Date.now()); });
    // The checks below speak the CMS's words; the browser's own stay out of the way.
    form.noValidate = true;
    stamp();

    const clear = () => {
      form.querySelectorAll<HTMLElement>("[data-error-for]").forEach((el) => { el.hidden = true; el.textContent = ""; });
      form.querySelectorAll("[aria-invalid]").forEach((el) => el.removeAttribute("aria-invalid"));
    };
    const show = (errors: FieldErrors) => {
      let first: HTMLElement | null = null;
      for (const [name, messages] of Object.entries(errors)) {
        const el = form.querySelector<HTMLElement>(`[data-error-for="${CSS.escape(name)}"]`);
        const label = name === "captcha" ? "" : labels.get(name) ?? name;
        const text = messages.map((message) => (name === "captcha" ? message : sentence(label, message))).join(" ");
        if (el) { el.textContent = text; el.hidden = false; }
        const input = form.querySelector<HTMLElement>(`[name="${CSS.escape(name)}"]`);
        input?.setAttribute("aria-invalid", "true");
        first ??= input;
      }
      first?.focus();
    };
    const resetCaptcha = () => {
      const w = window as unknown as { turnstile?: { reset(): void }; grecaptcha?: { reset(): void } };
      try { w.turnstile?.reset(); w.grecaptcha?.reset(); } catch { /* not loaded */ }
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      clear();
      const data = new FormData(form);
      const errors = validate(config.fields, postedFrom(data as unknown as { entries(): IterableIterator<[string, unknown]> }));
      if (Object.keys(errors).length) {
        form.dataset.state = "failed";
        status.textContent = "Please check the highlighted fields.";
        show(errors);
        return;
      }

      form.dataset.state = "sending";
      status.textContent = "Sending…";
      const body = form.enctype === "multipart/form-data" ? data : new URLSearchParams(data as unknown as Record<string, string>);
      try {
        const response = await fetch(form.action, { method: "POST", body, headers: { Accept: "application/json" } });
        const answer = await response.json().catch(() => ({})) as { message?: string; redirect?: string; errors?: FieldErrors };
        if (response.ok) {
          if (answer.redirect) { window.location.assign(new URL(answer.redirect, window.location.href).href); return; }
          form.dataset.state = "sent";
          form.reset();
          stamp();
          resetCaptcha();
          status.textContent = answer.message || config.success;
          return;
        }
        form.dataset.state = "failed";
        if (answer.errors) show(answer.errors);
        status.textContent = MESSAGES[response.status] ?? answer.message ?? "Something went wrong: please try again.";
        resetCaptcha();
      } catch {
        form.dataset.state = "failed";
        status.textContent = "Couldn't send: check your connection and try again.";
      }
    });
  }
</script>
