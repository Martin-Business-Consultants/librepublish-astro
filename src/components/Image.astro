---
/**
 * An image from the CMS, served from the CMS: the renditions it makes (its
 * `srcset`, at the widths GET /api/v1/site's `image_widths` names — 640, 1280
 * and 1920 by default) as a srcset, its size to hold the layout, its alt text.
 *
 *   <Image asset={assets[block.data.image_id]} sizes="(min-width: 60rem) 60rem, 100vw" />
 *
 * Renditions wider than the original are left out (the original stands in at
 * its own width); `widths` keeps only some. Nothing renders for a missing
 * asset. The focal point (set in the media library) becomes its
 * object-position, so a cropped image keeps it.
 */
import type { HTMLAttributes } from "astro/types";
import type { CmsAsset } from "@librepublish/astro/client";

interface Props extends Omit<HTMLAttributes<"img">, "src" | "srcset" | "width" | "height"> {
  asset: CmsAsset | null | undefined;
  alt?: string;
  sizes?: string;
  /** Only these rendition widths. */
  widths?: number[];
}

const { asset, alt, sizes = "100vw", widths, loading = "lazy", decoding = "async", style, ...rest } = Astro.props;
const position = asset && asset.focal_x != null && asset.focal_y != null && (asset.focal_x !== 0.5 || asset.focal_y !== 0.5)
  ? `${Math.round(asset.focal_x * 100)}% ${Math.round(asset.focal_y * 100)}%`
  : undefined;
// The site's own style wins; a string or an object, as Astro takes either.
const merged = !position ? style
  : style && typeof style === "object" ? { objectPosition: position, ...style }
  : [`object-position: ${position}`, style].filter(Boolean).join("; ");

const renditions = asset?.srcset?.length
  ? asset.srcset.map((item) => [item.width, item.url] as const)
  : Object.entries(asset?.variants ?? {}).map(([name, url]) => [Number(name.replace(/^w/, "")), url] as const);
const srcset = asset
  ? renditions
      .filter(([width]) => Number.isFinite(width) && (!asset.width || width < asset.width) && (!widths || widths.includes(width)))
      .sort(([a], [b]) => a - b)
      .map(([width, url]) => `${url} ${width}w`)
      .concat(renditions.length && asset.width ? [`${asset.original} ${asset.width}w`] : [])
      .join(", ")
  : "";
---
{asset && (
  <img
    src={asset.original}
    srcset={srcset || undefined}
    sizes={srcset ? sizes : undefined}
    width={asset.width ?? undefined}
    height={asset.height ?? undefined}
    alt={alt ?? asset.alt ?? ""}
    loading={loading}
    decoding={decoding}
    style={merged}
    {...rest}
  />
)}
