---
/**
 * A CMS rich text field as HTML: a `richtext` field's document (the admin
 * editor's Tiptap JSON), or Markdown (a `markdown` field, an entry's
 * `body_markdown`). Text is escaped and links go only to http(s), mailto:,
 * tel: or a path (renderRichText).
 *
 *   <RichText value={post.body_markdown} class="prose" />
 *   <h2><RichText value={block.heading} inline /></h2>
 *
 * Nothing is drawn for an empty value. With `class`, the HTML is wrapped in
 * a <div> (a <span> when inline) carrying it; without, it's placed as is.
 */
import { renderRichText, type RichTextDoc } from "@librepublish/astro/rich-text";

interface Props {
  /** A richtext field's document, or Markdown (a markdown field, body_markdown). */
  value: RichTextDoc | string | null | undefined;
  class?: string;
  /** One paragraph's worth, without the <p> around it. */
  inline?: boolean;
  /** The rel of links to other sites, e.g. "noopener noreferrer". */
  rel?: string;
  /** The target of links to other sites, e.g. "_blank". */
  target?: string;
}

const { value, class: className, inline = false, rel, target } = Astro.props;
const html = renderRichText(value, { inline, rel, target });
---
{html && (className
  ? (inline ? <span class={className} set:html={html} /> : <div class={className} set:html={html} />)
  : <Fragment set:html={html} />)}
