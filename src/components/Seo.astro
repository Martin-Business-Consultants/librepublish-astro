---
/**
 * The <head> tags for a page or entry from its `seo` (the fields GET
 * /api/v1/schema's `seo` lists): title, description, canonical URL, robots,
 * Open Graph and Twitter cards (the share image from the CMS), and hreflang
 * links to its translations.
 *
 *   <head><Seo record={page} assets={assets} siteName="Acme" /></head>
 */
import type { CmsAsset } from "@librepublish/astro/client";

interface Props {
  record: {
    title: string;
    locale: string;
    seo: Record<string, unknown>;
    translations: { locale: string; path: string }[];
  };
  assets?: Record<string, CmsAsset>;
  siteName?: string;
  /** Appended to the title: "About — Acme". */
  titleTemplate?: (title: string) => string;
}

const { record, assets = {}, siteName, titleTemplate = (title: string) => (siteName ? `${title} — ${siteName}` : title) } = Astro.props;
const seo = record.seo ?? {};
const text = (key: string) => (typeof seo[key] === "string" && seo[key] ? (seo[key] as string) : undefined);
const title = text("meta_title") ?? record.title;
const description = text("meta_description");
const canonical = text("canonical_url")
  ? new URL(text("canonical_url")!, Astro.site ?? Astro.url).href
  : Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const robots = [seo.noindex ? "noindex" : null, seo.nofollow ? "nofollow" : null].filter(Boolean).join(", ");
const share = text("og_image_id") ? assets[text("og_image_id")!] : undefined;
const alternates = Astro.site ? record.translations.map((translation) => ({ ...translation, href: new URL(translation.path, Astro.site).href })) : [];
---
<title>{titleTemplate(title)}</title>
{description && <meta name="description" content={description} />}
{canonical && <link rel="canonical" href={canonical} />}
{robots && <meta name="robots" content={robots} />}
<meta property="og:title" content={text("og_title") ?? title} />
{(text("og_description") ?? description) && <meta property="og:description" content={text("og_description") ?? description} />}
<meta property="og:type" content={text("og_type") ?? "website"} />
{canonical && <meta property="og:url" content={canonical} />}
{siteName && <meta property="og:site_name" content={siteName} />}
{share && <meta property="og:image" content={share.original} />}
{share?.width && <meta property="og:image:width" content={String(share.width)} />}
{share?.height && <meta property="og:image:height" content={String(share.height)} />}
{share?.alt && <meta property="og:image:alt" content={share.alt} />}
<meta name="twitter:card" content={text("twitter_card") ?? (share ? "summary_large_image" : "summary")} />
{share && <meta name="twitter:image" content={share.original} />}
{alternates.length > 0 && <link rel="alternate" hreflang={record.locale} href={canonical} />}
{alternates.map((alternate) => <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />)}
